<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.cockpit-kobo-ask-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/relay/server.ts</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__/relay</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__NODE_DIR__:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.agi-tools/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/cockpit-kobo-ask-relay.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/cockpit-kobo-ask-relay.log</string>
</dict>
</plist>
